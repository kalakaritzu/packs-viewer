{
  "name": "packs-viewer",
  "productName": "Packs Viewer",
  "version": "1.1.2",
  "description": "Fast, clean browser for your FL Studio sample packs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node tools/gen-icon.js",
    "dist": "node tools/gen-icon.js && electron-builder --win portable",
    "build": "node tools/gen-icon.js && tauri build --no-bundle",
    "install-app": "powershell -ExecutionPolicy Bypass -File tools/install.ps1",
    "installer": "node -e \"require('child_process').execFileSync(process.env.LOCALAPPDATA+'/tauri/NSIS/makensis.exe',['tools/setup.nsi'],{stdio:'inherit'})\""
  },
  "build": {
    "appId": "local.packsviewer",
    "productName": "Packs Viewer",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Packs Viewer.exe"
    }
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
