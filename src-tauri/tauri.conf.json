{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Packs Viewer",
  "version": "1.1.0",
  "identifier": "local.packsviewer",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Packs Viewer",
        "width": 780,
        "height": 780,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true,
        "visible": false,
        "backgroundColor": "#0f1115"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "Packs Viewer",
    "shortDescription": "Browse your FL Studio sample packs",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}